{
  "name": "thomson-calculator",
  "productName": "Thomson formula calculation",
  "description": "Calculates LC tank values",
  "version": "1.0.0",
  "author": "Roman Senn <roman.l.senn@gmail.com>",
  "homepage": "https://gitlab.com/rsenn/thomson-calculator",
  "main": "electron/main.js",
  "build": {
    "appId": "com.rlsenn.thomson-calculator",
    "productName": "Thomson formula calculation",
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    }
  },
  "scripts": {
    "start": "electron .",
    "web": "bun src/app.html",
    "test": "bun test test/",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.4.4",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0"
  },
  "type": "module"
}
