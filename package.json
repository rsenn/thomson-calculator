{
  "name": "thomson-calculator",
  "productName": "Thomson formula calculation",
  "description": "Calculates LC tank values",
  "version": "1.0.0",
  "author": "Roman Senn <roman.l.senn@gmail.com>",
  "homepage": "https://gitlab.com/rsenn/thomson-calculator",
  "main": "electron/main.js",
  "build": {
    "appId": "com.rlsenn.thomson-calculator",
    "productName": "thomson-calculator",
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "resources/icons",
      "desktop": {
        "entry": {
          "Name": "Thomson calculator",
          "Comment": "Calculates LC tank values"
        }
      }
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    }
  },
  "scripts": {
    "start": "electron .",
    "web": "bun src/app.html",
    "equations": "bun tools/equations.js",
    "glyphs": "bun tools/glyphs.js",
    "test": "bun test test/",
    "electron:pack": "electron-builder --dir",
    "electron:dist": "electron-builder",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build": "bun run electron:dist && bun run tauri:build"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/cli": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@types/bun": "^1.4.4",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "mathjax-full": "^3.2.2"
  },
  "type": "module"
}
