{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Thomson calculator",
  "version": "0.1.0",
  "identifier": "com.rsenn.thomson-calculator",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run web"
  },
  "app": {
    "windows": [
      {
        "title": "Thomson calculator",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "url": "app.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "nsis",
      "msi",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "category": "Utility",
    "shortDescription": "Calculates LC tank values",
    "longDescription": "Thomson formula calculator for LC circuits: solve L, C or f, with ranges and tuning bands.",
    "publisher": "Roman Senn",
    "homepage": "https://github.com/rsenn/thomson-calculator"
  },
  "mainBinaryName": "thomson-calculator"
}
